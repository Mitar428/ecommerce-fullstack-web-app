{% extends "products/homeLayout.html.twig" %}


{% block title %}
Završetak kupovine
{% endblock %}



{% block body %}

<div class="container mt-5">

    <h2 class="mb-4">
        Završetak kupovine
    </h2>



    <div class="row">


        <!-- PODACI KUPCA -->
        <div class="col-md-6">


            <div class="card shadow p-4">


                <h4 class="mb-3">
                    Podaci za dostavu
                </h4>


                <form method="post" action="/ecommerce-shop/public/checkout">


                    <div class="mb-3">

                        <label class="form-label">
                            Ime
                        </label>

                        <input 
                        type="text" 
                        name="ime" 
                        class="form-control"
                        required>

                    </div>



                    <div class="mb-3">

                        <label class="form-label">
                            Prezime
                        </label>

                        <input 
                        type="text" 
                        name="prezime" 
                        class="form-control"
                        required>

                    </div>




                    <div class="mb-3">

                        <label class="form-label">
                            Adresa
                        </label>

                        <input 
                        type="text" 
                        name="adresa" 
                        class="form-control"
                        required>

                    </div>




                    <div class="mb-3">

                        <label class="form-label">
                            Grad
                        </label>

                        <input 
                        type="text" 
                        name="grad" 
                        class="form-control"
                        required>

                    </div>




                    <div class="mb-3">

                        <label class="form-label">
                            Telefon
                        </label>

                        <input 
                        type="text" 
                        name="telefon" 
                        class="form-control"
                        required>

                    </div>



                    <button class="btn btn-success w-100">

                        Potvrdi porudžbinu

                    </button>



                </form>


            </div>


        </div>





        <!-- PREGLED KORPE -->
        <div class="col-md-6">


            <div class="card shadow p-4">


                <h4>
                    Vaša korpa
                </h4>


                {% set ukupno = 0 %}



                {% for item in items %}


                <div class="border-bottom py-3">


                    <div class="row">


                    {% if item.slika starts with 'product_'%}

                      
                        <img src="{{ app_url }}/assets/images/products/{{ item.slika }}"
                        class="card-img-top"
                        alt="{{ item.naziv }}" width="30">

                        {% else %}

                        <img src="{{ app_url }}/images/{{ item.slika }}"
                        class="card-img-top"
                        alt="{{ item.naziv }}" width="30">


                        {% endif %}

                        </div>



                        <div class="col-8">


                            <h5>
                                {{ item.naziv }}
                            </h5>


                            <p>
                                Količina:
                                {{ item.kolicina }}
                            </p>


                            <p>
                                Cena:
                                {{ item.cena }} RSD
                            </p>


                            <p>
                                Ukupno:
                                {{ item.ukupno }} RSD
                            </p>


                        </div>


                    </div>


                </div>


                {% set ukupno = ukupno + item.ukupno %}



                {% else %}


                <p>
                    Korpa je prazna.
                </p>


                {% endfor %}




                <hr>



                <h4 class="text-end">

                    Ukupno za plaćanje:

                    {{ ukupno }} RSD

                </h4>



            </div>


        </div>



    </div>


</div>


{% endblock %}