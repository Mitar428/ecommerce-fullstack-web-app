{% extends 'layout.html.twig' %}

{% block title %}Promena lozinke{% endblock %}

{% block content %}

<div class="container mt-5" style="max-width:500px;">

    <div class="card shadow">
        <div class="card-body">

            <h3 class="text-center mb-4">
                Promena lozinke
            </h3>

            <form method="POST" action="{{ app_url }}/changepassword">

                <div class="mb-3">
                    <label class="form-label">
                        Email adresa
                    </label>

                    <input
                        type="email"
                        name="email"
                        class="form-control"
                        required
                    >
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Nova lozinka
                    </label>

                    <input
                        type="password"
                        name="lozinka"
                        class="form-control"
                        required
                    >
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Potvrdite novu lozinku
                    </label>

                    <input
                        type="password"
                        name="potvrda_lozinke"
                        class="form-control"
                        required
                    >
                </div>

                <button
                    type="submit"
                    class="btn btn-primary w-100">
                    Promeni lozinku
                </button>

            </form>

            <div class="text-center mt-3">
                <a href="{{ app_url }}/login">
                    Nazad na prijavu
                </a>
            </div>

        </div>
    </div>

</div>

{% endblock %}