{% extends "layout.html.twig" %}

{% block title %}
Login
{% endblock %}


{% block content %}

<h2>Prijava</h2>

<form method="POST" action="{{ app_url }}/login">

    <div class="mb-3">
        <label>Email</label>
        <input type="email" name="email" method="POST" class="form-control">
    </div>


    <div class="mb-3">
        <label>Lozinka</label>
        <input type="password" name="lozinka" class="form-control">
    </div>


    <button class="btn btn-primary">
        Prijavi se
    </button>

    <div class="links">

    <a href="{{ app_url }}/registracija">
    nemate nalog? registrujte se
    </a>

</div>

    <div class="text-center mt-3">
            <a href="{{ app_url }}/changepassword">
                zaboravili ste lozinku?
            </a>
        </div>

</form>

{% endblock %}