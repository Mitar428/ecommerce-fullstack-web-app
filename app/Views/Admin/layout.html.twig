<!DOCTYPE html>
<html>

<head>

<meta charset="UTF-8">

<title>
Admin Panel
</title>


<style>


*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial;
}


body{

    background:#f4f6f9;

}



.admin-wrapper{

    display:flex;

    min-height:100vh;

}



.sidebar{

    width:260px;

    background:#111827;

    color:white;

    padding:20px;

}



.logo{

    margin-bottom:40px;

}



.sidebar ul{

    list-style:none;

}



.sidebar li{

    margin-bottom:15px;

}



.sidebar a{

    color:white;

    text-decoration:none;

    display:block;

    padding:12px;

    border-radius:8px;

}



.sidebar a:hover,
.sidebar .active a{

    background:#2563eb;

}




.content{

    flex:1;

    padding:30px;

}



.topbar{

    display:flex;

    justify-content:space-between;

    margin-bottom:30px;

}



.cards{

    display:grid;

    grid-template-columns:repeat(4,1fr);

    gap:20px;

}



.card{

    background:white;

    padding:25px;

    border-radius:12px;

    box-shadow:0 5px 15px #ddd;

}



.card p{

    font-size:30px;

    font-weight:bold;

    margin-top:15px;

}



.box{

    background:white;

    margin-top:30px;

    padding:25px;

    border-radius:12px;

}



.box-header{

    display:flex;

    justify-content:space-between;

    margin-bottom:20px;

}



.box-header a{

    background:#2563eb;

    color:white;

    padding:10px 15px;

    border-radius:6px;

    text-decoration:none;

}



table{

    width:100%;

    border-collapse:collapse;

}



th,td{

    padding:15px;

    border-bottom:1px solid #ddd;

    text-align:left;

}



.success{

    background:#22c55e;
    color:white;
    padding:5px 10px;
    border-radius:20px;

}


.warning{

    background:#f59e0b;
    color:white;
    padding:5px 10px;
    border-radius:20px;

}


.danger{

    background:#ef4444;
    color:white;
    padding:5px 10px;
    border-radius:20px;

}


.edit{

    color:#2563eb;

}


.delete{

    color:red;

}


</style>


</head>


<body>


{% block content %}

{% endblock %}


</body>

</html>