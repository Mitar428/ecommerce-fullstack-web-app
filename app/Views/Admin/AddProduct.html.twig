{% extends "admin/AddProductLayout.html.twig" %}

{% block title %}
Dodaj proizvod
{% endblock %}

{% block body %}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow">

                <div class="card-header bg-dark text-white">
                    <h3>Dodaj novi proizvod</h3>
                </div>

                <div class="card-body">

                    <form action="{{ app_url }}/admin/proizvodi/dodaj"
                          method="POST"
                          enctype="multipart/form-data">

                        <div class="mb-3">
                            <label class="form-label">Naziv proizvoda</label>
                            <input
                                type="text"
                                class="form-control"
                                name="naziv"
                                required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Opis</label>
                            <textarea
                                class="form-control"
                                name="opis"
                                rows="5"
                                required></textarea>
                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Cena (RSD)</label>
                                <input
                                    type="number"
                                    class="form-control"
                                    name="cena"
                                    required>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Stanje</label>
                                <input
                                    type="number"
                                    class="form-control"
                                    name="stanje"
                                    required>
                            </div>

                        </div>

                        <div class="mb-3">

                            <label class="form-label">Kategorija</label>

                            <select
                                class="form-select"
                                name="kategorija_id"
                                required>

                                {% for kategorija in kategorije %}

                                    <option value="{{ kategorija.kategorija_id }}">
                                        {{ kategorija.naziv }}
                                    </option>

                                {% endfor %}

                            </select>

                        </div>

                        <div class="mb-3">

                            <label class="form-label">Brend</label>

                            <select
                                class="form-select"
                                name="brend_id"
                                required>

                                {% for brend in brendovi %}

                                    <option value="{{ brend.brend_id }}">
                                        {{ brend.naziv }}
                                    </option>

                                {% endfor %}

                            </select>

                        </div>

                        <div class="mb-3">

                            <label class="form-label">Slika proizvoda</label>

                            <input
                                type="file"
                                class="form-control"
                                name="slika"
                                accept=".jpg,.jpeg,.png,.webp"
                                required>

                        </div>

                        <button
                            type="submit"
                            class="btn btn-success w-100">

                            Dodaj proizvod

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

{% endblock %}