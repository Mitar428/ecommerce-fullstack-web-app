{% extends "account/layout.html.twig" %}


{% block title %}
Moje adrese
{% endblock %}


{% block content %}

<div class="container">

<h2>
<i class="bi bi-geo-alt"></i>
Moje adrese
</h2>


<div class="card p-4 mt-4">


<h5>Adresa za dostavu</h5>


<p>
<strong>Adresa:</strong>
{{ adresa.adresa }}
</p>


<p>
<strong>Grad:</strong>
{{ adresa.grad }}
</p>


<p>
<strong>Poštanski broj:</strong>
{{ adresa.postanski_broj }}
</p>


<p>
<strong>Telefon:</strong>
{{ adresa.telefon }}
</p>




</div>


</div>

{% endblock %}