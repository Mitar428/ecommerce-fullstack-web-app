<!DOCTYPE html>
<html lang="sr">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        {% block title %}
            Admin Settings
        {% endblock %}
    </title>


    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">


    <style>

        body {
            background: #f4f6f9;
            min-height: 100vh;
        }


        .sidebar {
            min-height: 100vh;
            background: #212529;
        }


        .sidebar a {
            color: white;
            text-decoration: none;
            display: block;
            padding: 12px;
            border-radius: 5px;
        }


        .sidebar a:hover {
            background: #343a40;
        }


        .content {
            padding: 30px;
        }


    </style>


</head>


<body>


<div class="container-fluid">

    <div class="row">


        <!-- SIDEBAR -->

        <div class="col-md-3 sidebar p-4">


            <h3 class="text-white mb-4">
                Admin Panel
            </h3>


            <a href="{{ app_url }}/admin">
                🏠 Dashboard
            </a>


            <a href="{{ app_url }}/admin/products">
                📦 Proizvodi
            </a>


            <a href="{{ app_url }}/admin/orders">
                🛒 Porudžbine
            </a>


            <a href="{{ app_url }}/admin/users">
                👥 Korisnici
            </a>


            <a href="{{ app_url }}/admin/profile">
                👤 Profil
            </a>


            <a href="{{ app_url }}/admin/settings">
                ⚙ Podešavanja
            </a>


            <a href="{{ app_url }}/logout">
                🚪 Odjava
            </a>


        </div>



        <!-- CONTENT -->

        <div class="col-md-9 content">


            {% block body %}

            {% endblock %}


        </div>


    </div>


</div>



<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


</body>

</html>